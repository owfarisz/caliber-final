{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "esnext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "components/staging/**/*.tsx",
    "lib/domain.ts",
    "lib/persistence.ts",
    "lib/imports.ts",
    "lib/monitoring.ts",
    "lib/planning.ts",
    "scripts/staging-entry.tsx",
    "tests/workflow.test.ts",
    "tests/staging.test.ts",
    "lib/demo-*.ts",
    "lib/supplier.ts",
    "tests/guided-demo.test.ts"
  ]
}
