{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "esnext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ]
  },
  "include": [
    "components/**/*.tsx",
    "lib/engine.ts",
    "lib/types.ts",
    "lib/equipment-kind.ts",
    "scripts/pages-entry.tsx"
  ]
}